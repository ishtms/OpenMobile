<?xml version="1.0" encoding="utf-8"?>
<root>
	<iosPListUpdates>
		<setIntFromPropertyArrayNum result="OpenMobileDeviceUrlSchemeCount" ini="Game" section="/Script/OpenMobileDevice.OpenMobileDeviceSettings" property="DeclaredUrlSchemes"/>
		<setBoolIsGreater result="OpenMobileDeviceHasUrlSchemes" arg1="$I(OpenMobileDeviceUrlSchemeCount)" arg2="0"/>
		<if condition="OpenMobileDeviceHasUrlSchemes">
			<true>
				<setBool result="OpenMobileDeviceQueriesArrayFound" value="false"/>
				<loopElements tag="dict">
					<setBool result="OpenMobileDeviceQueriesKeyFound" value="false"/>
					<loopElements tag="$">
						<setStringFromTag result="OpenMobileDevicePlistTag" tag="$"/>
						<if condition="OpenMobileDeviceQueriesKeyFound">
							<true>
								<setBoolIsEqual result="OpenMobileDevicePlistTagIsArray" arg1="$S(OpenMobileDevicePlistTag)" arg2="array"/>
								<if condition="OpenMobileDevicePlistTagIsArray">
									<true>
										<setBool result="OpenMobileDeviceQueriesArrayFound" value="true"/>
									</true>
								</if>
							</true>
						</if>
						<if condition="OpenMobileDeviceQueriesArrayFound">
							<false>
								<setBoolIsEqual result="OpenMobileDevicePlistTagIsKey" arg1="$S(OpenMobileDevicePlistTag)" arg2="key"/>
								<if condition="OpenMobileDevicePlistTagIsKey">
									<true>
										<setStringFromTagText result="OpenMobileDevicePlistKey" tag="$"/>
										<setBoolIsEqual result="OpenMobileDeviceQueriesKeyFound" arg1="$S(OpenMobileDevicePlistKey)" arg2="LSApplicationQueriesSchemes"/>
									</true>
								</if>
							</false>
						</if>
					</loopElements>
				</loopElements>
				<setBoolNot result="OpenMobileDeviceNeedsQueriesArray" source="$B(OpenMobileDeviceQueriesArrayFound)"/>
				<if condition="OpenMobileDeviceNeedsQueriesArray">
					<true>
						<addElements tag="dict" once="true">
							<key>LSApplicationQueriesSchemes</key>
							<array/>
						</addElements>
					</true>
				</if>
				<setString result="OpenMobileDeviceAsciiLetters" value="abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ"/>
				<setString result="OpenMobileDeviceUrlSchemeCharacters" value="abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789+-."/>
				<setString result="OpenMobileDeviceUnsafeUrlSchemes" value="|about|blob|content|data|file|intent|javascript|http|https|"/>
				<setBool result="OpenMobileDeviceQueriesArrayHandled" value="false"/>
				<loopElements tag="dict">
					<setBool result="OpenMobileDeviceQueriesKeyFound" value="false"/>
					<loopElements tag="$">
						<setStringFromTag result="OpenMobileDevicePlistTag" tag="$"/>
						<if condition="OpenMobileDeviceQueriesKeyFound">
							<true>
								<setBoolIsEqual result="OpenMobileDevicePlistTagIsArray" arg1="$S(OpenMobileDevicePlistTag)" arg2="array"/>
								<setBoolNot result="OpenMobileDeviceQueriesArrayNotHandled" source="$B(OpenMobileDeviceQueriesArrayHandled)"/>
								<setBoolAnd result="OpenMobileDeviceShouldPopulateQueriesArray" arg1="$B(OpenMobileDevicePlistTagIsArray)" arg2="$B(OpenMobileDeviceQueriesArrayNotHandled)"/>
								<if condition="OpenMobileDeviceShouldPopulateQueriesArray">
									<true>
										<setString result="OpenMobileDeviceSeenUrlSchemes" value="|"/>
										<setInt result="OpenMobileDeviceValidUrlSchemeCount" value="0"/>
										<loopElements tag="$">
											<setStringFromTag result="OpenMobileDeviceExistingSchemeTag" tag="$"/>
											<setBoolIsEqual result="OpenMobileDeviceExistingSchemeIsString" arg1="$S(OpenMobileDeviceExistingSchemeTag)" arg2="string"/>
											<if condition="OpenMobileDeviceExistingSchemeIsString">
												<true>
													<setStringFromTagText result="OpenMobileDeviceExistingScheme" tag="$"/>
													<setStringToLower result="OpenMobileDeviceExistingScheme" source="$S(OpenMobileDeviceExistingScheme)"/>
													<setStringAdd result="OpenMobileDeviceExistingSchemeKey" arg1="|" arg2="$S(OpenMobileDeviceExistingScheme)"/>
													<setStringAdd result="OpenMobileDeviceExistingSchemeKey" arg1="$S(OpenMobileDeviceExistingSchemeKey)" arg2="|"/>
													<setBoolContains result="OpenMobileDeviceExistingSchemeDuplicate" source="$S(OpenMobileDeviceSeenUrlSchemes)" find="$S(OpenMobileDeviceExistingSchemeKey)"/>
													<if condition="OpenMobileDeviceExistingSchemeDuplicate">
														<false>
															<setStringAdd result="OpenMobileDeviceSeenUrlSchemes" arg1="$S(OpenMobileDeviceSeenUrlSchemes)" arg2="$S(OpenMobileDeviceExistingSchemeKey)"/>
															<setIntAdd result="OpenMobileDeviceValidUrlSchemeCount" arg1="$I(OpenMobileDeviceValidUrlSchemeCount)" arg2="1"/>
														</false>
													</if>
												</true>
											</if>
										</loopElements>
										<setInt result="OpenMobileDeviceUrlSchemeIndex" value="0"/>
										<setBoolIsLess result="OpenMobileDeviceHasUrlScheme" arg1="$I(OpenMobileDeviceUrlSchemeIndex)" arg2="$I(OpenMobileDeviceUrlSchemeCount)"/>
										<while condition="OpenMobileDeviceHasUrlScheme">
											<setStringFromPropertyArray result="OpenMobileDeviceUrlScheme" ini="Game" section="/Script/OpenMobileDevice.OpenMobileDeviceSettings" property="DeclaredUrlSchemes" index="$I(OpenMobileDeviceUrlSchemeIndex)"/>
											<setIntAdd result="OpenMobileDeviceUrlSchemeIndex" arg1="$I(OpenMobileDeviceUrlSchemeIndex)" arg2="1"/>
											<setBoolIsLess result="OpenMobileDeviceHasUrlScheme" arg1="$I(OpenMobileDeviceUrlSchemeIndex)" arg2="$I(OpenMobileDeviceUrlSchemeCount)"/>
											<setStringToLower result="OpenMobileDeviceNormalizedUrlScheme" source="$S(OpenMobileDeviceUrlScheme)"/>
											<setIntLength result="OpenMobileDeviceUrlSchemeLength" source="$S(OpenMobileDeviceUrlScheme)"/>
											<setBoolIsGreater result="OpenMobileDeviceUrlSchemeValid" arg1="$I(OpenMobileDeviceUrlSchemeLength)" arg2="0"/>
											<if condition="OpenMobileDeviceUrlSchemeValid">
												<true>
													<setStringSubstring result="OpenMobileDeviceUrlSchemeCharacter" source="$S(OpenMobileDeviceUrlScheme)" start="0" length="1"/>
													<setBoolContains result="OpenMobileDeviceUrlSchemeFirstCharacterValid" source="$S(OpenMobileDeviceAsciiLetters)" find="$S(OpenMobileDeviceUrlSchemeCharacter)"/>
													<setBoolAnd result="OpenMobileDeviceUrlSchemeValid" arg1="$B(OpenMobileDeviceUrlSchemeValid)" arg2="$B(OpenMobileDeviceUrlSchemeFirstCharacterValid)"/>
													<setInt result="OpenMobileDeviceUrlSchemeCharacterIndex" value="1"/>
													<setBoolIsLess result="OpenMobileDeviceHasUrlSchemeCharacter" arg1="$I(OpenMobileDeviceUrlSchemeCharacterIndex)" arg2="$I(OpenMobileDeviceUrlSchemeLength)"/>
													<while condition="OpenMobileDeviceHasUrlSchemeCharacter">
														<setStringSubstring result="OpenMobileDeviceUrlSchemeCharacter" source="$S(OpenMobileDeviceUrlScheme)" start="$I(OpenMobileDeviceUrlSchemeCharacterIndex)" length="1"/>
														<setBoolContains result="OpenMobileDeviceUrlSchemeCharacterValid" source="$S(OpenMobileDeviceUrlSchemeCharacters)" find="$S(OpenMobileDeviceUrlSchemeCharacter)"/>
														<setBoolAnd result="OpenMobileDeviceUrlSchemeValid" arg1="$B(OpenMobileDeviceUrlSchemeValid)" arg2="$B(OpenMobileDeviceUrlSchemeCharacterValid)"/>
														<setIntAdd result="OpenMobileDeviceUrlSchemeCharacterIndex" arg1="$I(OpenMobileDeviceUrlSchemeCharacterIndex)" arg2="1"/>
														<setBoolIsLess result="OpenMobileDeviceHasUrlSchemeCharacter" arg1="$I(OpenMobileDeviceUrlSchemeCharacterIndex)" arg2="$I(OpenMobileDeviceUrlSchemeLength)"/>
													</while>
												</true>
											</if>
											<setStringAdd result="OpenMobileDeviceUrlSchemeKey" arg1="|" arg2="$S(OpenMobileDeviceNormalizedUrlScheme)"/>
											<setStringAdd result="OpenMobileDeviceUrlSchemeKey" arg1="$S(OpenMobileDeviceUrlSchemeKey)" arg2="|"/>
											<setBoolContains result="OpenMobileDeviceUrlSchemeUnsafe" source="$S(OpenMobileDeviceUnsafeUrlSchemes)" find="$S(OpenMobileDeviceUrlSchemeKey)"/>
											<setBoolNot result="OpenMobileDeviceUrlSchemeSafe" source="$B(OpenMobileDeviceUrlSchemeUnsafe)"/>
											<setBoolAnd result="OpenMobileDeviceUrlSchemeValid" arg1="$B(OpenMobileDeviceUrlSchemeValid)" arg2="$B(OpenMobileDeviceUrlSchemeSafe)"/>
											<setBoolContains result="OpenMobileDeviceUrlSchemeDuplicate" source="$S(OpenMobileDeviceSeenUrlSchemes)" find="$S(OpenMobileDeviceUrlSchemeKey)"/>
											<setBoolNot result="OpenMobileDeviceUrlSchemeUnique" source="$B(OpenMobileDeviceUrlSchemeDuplicate)"/>
											<setBoolAnd result="OpenMobileDeviceUrlSchemeValid" arg1="$B(OpenMobileDeviceUrlSchemeValid)" arg2="$B(OpenMobileDeviceUrlSchemeUnique)"/>
											<setBoolIsLess result="OpenMobileDeviceUrlSchemeBelowLimit" arg1="$I(OpenMobileDeviceValidUrlSchemeCount)" arg2="50"/>
											<setBoolAnd result="OpenMobileDeviceUrlSchemeValid" arg1="$B(OpenMobileDeviceUrlSchemeValid)" arg2="$B(OpenMobileDeviceUrlSchemeBelowLimit)"/>
											<if condition="OpenMobileDeviceUrlSchemeValid">
												<true>
													<setElement result="OpenMobileDeviceUrlSchemeEntry" value="string" text="$S(OpenMobileDeviceNormalizedUrlScheme)"/>
													<addElement tag="$" name="OpenMobileDeviceUrlSchemeEntry"/>
													<setStringAdd result="OpenMobileDeviceSeenUrlSchemes" arg1="$S(OpenMobileDeviceSeenUrlSchemes)" arg2="$S(OpenMobileDeviceUrlSchemeKey)"/>
													<setIntAdd result="OpenMobileDeviceValidUrlSchemeCount" arg1="$I(OpenMobileDeviceValidUrlSchemeCount)" arg2="1"/>
												</true>
											</if>
										</while>
										<setBool result="OpenMobileDeviceQueriesArrayHandled" value="true"/>
									</true>
								</if>
							</true>
						</if>
						<if condition="OpenMobileDeviceQueriesArrayHandled">
							<false>
								<setBoolIsEqual result="OpenMobileDevicePlistTagIsKey" arg1="$S(OpenMobileDevicePlistTag)" arg2="key"/>
								<if condition="OpenMobileDevicePlistTagIsKey">
									<true>
										<setStringFromTagText result="OpenMobileDevicePlistKey" tag="$"/>
										<setBoolIsEqual result="OpenMobileDeviceQueriesKeyFound" arg1="$S(OpenMobileDevicePlistKey)" arg2="LSApplicationQueriesSchemes"/>
									</true>
								</if>
							</false>
						</if>
					</loopElements>
				</loopElements>
			</true>
		</if>
	</iosPListUpdates>
</root>
