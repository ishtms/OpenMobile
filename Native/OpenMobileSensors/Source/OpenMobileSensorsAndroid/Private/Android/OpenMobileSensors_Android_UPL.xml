<?xml version="1.0" encoding="utf-8"?>
<root xmlns:android="http://schemas.android.com/apk/res/android">
	<init>
		<setBoolFromProperty result="OpenMobileSensorsHighSamplingEnabled" ini="Engine" section="/Script/OpenMobileSensors.OpenMobileSensorsSettings" property="bAllowHighSamplingRate" default="false"/>
		<setBoolFromProperty result="OpenMobileSensorsPermissionSensitiveEnabled" ini="Engine" section="/Script/OpenMobileSensors.OpenMobileSensorsSettings" property="bEnablePermissionSensitiveSensors" default="false"/>
	</init>

	<androidManifestUpdates>
		<if condition="OpenMobileSensorsHighSamplingEnabled">
			<true>
				<addPermission android:name="android.permission.HIGH_SAMPLING_RATE_SENSORS"/>
			</true>
		</if>
		<if condition="OpenMobileSensorsPermissionSensitiveEnabled">
			<true>
				<addPermission android:name="android.permission.ACTIVITY_RECOGNITION"/>
			</true>
		</if>
	</androidManifestUpdates>

	<resourceCopies>
		<copyFile
			src="$S(PluginDir)/src/com/openmobile/sensors/OpenMobileSensorsBridgeV1.java"
			dst="$S(BuildDir)/src/com/openmobile/sensors/OpenMobileSensorsBridgeV1.java"/>
	</resourceCopies>

	<gameActivityOnResumeAdditions>
		<insert>
	com.openmobile.sensors.OpenMobileSensorsBridgeV1.onActivityResumed(this);
		</insert>
	</gameActivityOnResumeAdditions>

	<gameActivityOnPauseAdditions>
		<insert>
	com.openmobile.sensors.OpenMobileSensorsBridgeV1.onActivityPaused(this);
		</insert>
	</gameActivityOnPauseAdditions>

	<gameActivityOnDestroyAdditions>
		<insert>
	com.openmobile.sensors.OpenMobileSensorsBridgeV1.onActivityDestroyed(this);
		</insert>
	</gameActivityOnDestroyAdditions>

	<gameActivityOnRequestPermissionsResultAdditions>
		<insert>
	com.openmobile.sensors.OpenMobileSensorsBridgeV1.onPermissionsChanged(this, requestCode, permissions, grantResults);
		</insert>
	</gameActivityOnRequestPermissionsResultAdditions>
</root>
