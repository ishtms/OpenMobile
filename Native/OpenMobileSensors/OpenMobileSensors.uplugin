	"FriendlyName": "OpenMobile Sensors",
	"Description": "Portable mobile sensor discovery and streaming APIs with isolated Android and iOS implementations.",
	"Category": "OpenMobile",
	"CreatedBy": "OpenMobile",
	"EngineVersion": "5.8.0",
