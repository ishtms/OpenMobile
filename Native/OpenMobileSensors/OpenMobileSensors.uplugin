			"LoadingPhase": "PreDefault",
			"PlatformAllowList": ["Android"]
		},
		{
			"Name": "OpenMobileSensorsIOS",
			"Type": "Runtime",
			"LoadingPhase": "PreDefault",
			"PlatformAllowList": ["IOS"]
		},
		{
			"Name": "OpenMobileSensorsConsumerTests",
			"Type": "DeveloperTool",
			"LoadingPhase": "Default"
		},
		{
			"Name": "OpenMobileSensorsValidation",
			"Type": "DeveloperTool",
			"LoadingPhase": "Default"
		},
		{
			"Name": "OpenMobileSensorsEditor",
			"Type": "Editor",
			"LoadingPhase": "Default"
		}
	],
	"Plugins": [
		{
			"Name": "OpenMobileCore",
			"Enabled": true
		},
		{
			"Name": "OpenMobilePermissions",
			"Enabled": true
		}
	]
