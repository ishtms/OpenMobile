<?xml version="1.0" encoding="utf-8"?>
<root>
    <minimumSDKAPI>
        <insertValue value="23"/>
        <insertNewline/>
    </minimumSDKAPI>

    <buildGradleAdditions>
        <insert>
repositories {
    google()
    mavenCentral()
}
dependencies {
    implementation('com.google.ads.mediation:facebook') {
        version {
            strictly '6.22.0.0'
        }
    }
}
        </insert>
        <insert>apply from: rootProject.file('OpenMobileAdsAdMobMeta_Dependencies.gradle')</insert>
        <insertNewline/>
    </buildGradleAdditions>

    <registerBuildSettings>
        <insert>OpenMobileAdsAdMobMetaAndroidDependencyContract=1</insert>
        <insertNewline/>
    </registerBuildSettings>

    <gradleCopies>
        <copyFile
            src="$S(PluginDir)/OpenMobileAdsAdMobMeta_Dependencies.gradle"
            dst="$S(BuildDir)/gradle/OpenMobileAdsAdMobMeta_Dependencies.gradle"/>
        <copyFile
            src="$S(PluginDir)/OpenMobileAdsAdMobMeta_Dependencies.gradle"
            dst="$S(BuildDir)/gradle/AFSProject/OpenMobileAdsAdMobMeta_Dependencies.gradle"/>
    </gradleCopies>
</root>
